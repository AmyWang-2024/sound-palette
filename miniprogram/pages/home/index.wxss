.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.art-card {
  position: relative;
  width: 100%;
  height: 680rpx;
  overflow: hidden;
  border: 1rpx solid rgba(37, 34, 40, 0.12);
  border-radius: 48rpx;
  background: #f5f0e9;
  box-shadow: 0 24rpx 72rpx rgba(59, 52, 62, 0.1);
}

.visual-canvas {
  width: 100%;
  height: 100%;
}

.listening-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(32, 29, 36, 0.2);
  backdrop-filter: blur(2rpx);
}

.listening-kicker {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.countdown {
  margin-top: 12rpx;
  font-family: Georgia, serif;
  font-size: 128rpx;
  line-height: 1;
}

.progress-track {
  width: 360rpx;
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.92);
  transition: width 100ms linear;
}

.listening-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.content {
  display: flex;
  flex-direction: column;
  padding: 50rpx 8rpx 0;
}

.eyebrow {
  color: #6d6670;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.title,
.state-title {
  margin-top: 18rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 68rpx;
  line-height: 1.08;
}

.state-title {
  font-size: 52rpx;
}

.copy {
  margin-top: 24rpx;
  color: #6d6670;
  font-size: 28rpx;
  line-height: 1.75;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin-top: 40rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.primary-button {
  color: #f9f6f1;
  background: #2e2a31;
}

.secondary-button {
  color: #2e2a31;
  border: 1rpx solid rgba(46, 42, 49, 0.22);
  background: rgba(255, 255, 255, 0.32);
}

.primary-button::after,
.secondary-button::after,
.mood-option::after {
  border: 0;
}

.privacy-note {
  margin-top: 20rpx;
  color: #817a83;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.mood-list {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.mood-option {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 24rpx 18rpx;
  color: #57515a;
  border: 1rpx solid rgba(46, 42, 49, 0.14);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.34);
  line-height: 1.25;
  text-align: left;
}

.mood-option.is-selected {
  color: #f9f6f1;
  border-color: #2e2a31;
  background: #2e2a31;
}

.mood-label {
  font-size: 28rpx;
  font-weight: 600;
}

.mood-detail {
  margin-top: 10rpx;
  font-size: 20rpx;
  opacity: 0.72;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.tag {
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(46, 42, 49, 0.14);
  border-radius: 999rpx;
  color: #5f5862;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.4);
}

.composition-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(46, 42, 49, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.36);
}

.composition-row {
  display: grid;
  grid-template-columns: 64rpx 1fr 72rpx;
  gap: 18rpx;
  align-items: center;
  color: #6d6670;
  font-size: 22rpx;
}

.composition-track {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(46, 42, 49, 0.1);
}

.composition-fill {
  height: 100%;
  border-radius: inherit;
  background: #777079;
}

@media (max-width: 340px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .mood-list {
    flex-direction: column;
  }

  .mood-option {
    width: 100%;
  }
}
