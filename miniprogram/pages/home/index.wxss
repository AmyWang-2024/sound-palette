.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.art-card {
  position: relative;
  width: 100%;
  height: 680rpx;
  overflow: hidden;
  border: 1rpx solid rgba(37, 34, 40, 0.12);
  border-radius: 48rpx;
  background: #f5f0e9;
  box-shadow: 0 24rpx 72rpx rgba(59, 52, 62, 0.1);
}

.visual-canvas {
  width: 100%;
  height: 100%;
}

.export-canvas {
  position: fixed;
  z-index: -1;
  top: -10px;
  left: -10px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.listening-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(32, 29, 36, 0.2);
  backdrop-filter: blur(2rpx);
}

.listening-kicker {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.countdown {
  margin-top: 12rpx;
  font-family: Georgia, serif;
  font-size: 128rpx;
  line-height: 1;
}

.progress-track {
  width: 360rpx;
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.3);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.92);
  transition: width 100ms linear;
}

.sound-response {
  width: 360rpx;
  margin-top: 24rpx;
}

.sound-response-header {
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
}

.sound-response-track {
  height: 12rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 999rpx;
  background: rgba(26, 23, 29, 0.2);
}

.sound-response-fill {
  min-width: 4rpx;
  height: 100%;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.94);
  transition: width 120ms ease-out;
}

.listening-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.stop-button {
  min-width: 200rpx;
  margin-top: 28rpx;
  padding: 10rpx 28rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 999rpx;
  font-size: 23rpx;
  background: rgba(30, 27, 34, 0.24);
}

.stop-button::after {
  border: 0;
}

.content {
  display: flex;
  flex-direction: column;
  padding: 50rpx 8rpx 0;
}

.eyebrow {
  color: #6d6670;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.title,
.state-title {
  margin-top: 18rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 68rpx;
  line-height: 1.08;
}

.state-title {
  font-size: 52rpx;
}

.copy {
  margin-top: 24rpx;
  color: #6d6670;
  font-size: 28rpx;
  line-height: 1.75;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin-top: 40rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.primary-button {
  color: #f9f6f1;
  background: #2e2a31;
}

.secondary-button {
  color: #2e2a31;
  border: 1rpx solid rgba(46, 42, 49, 0.22);
  background: rgba(255, 255, 255, 0.32);
}

.primary-button::after,
.secondary-button::after,
.mood-option::after {
  border: 0;
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: 0.58;
}

.sample-button,
.compact-button {
  margin-top: 18rpx;
}

.compact-button {
  min-height: 84rpx;
  font-size: 26rpx;
}

.status-card {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  color: #625b65;
  border-left: 5rpx solid #8d7f8c;
  border-radius: 0 18rpx 18rpx 0;
  font-size: 24rpx;
  line-height: 1.65;
  background: rgba(255, 255, 255, 0.42);
}

.export-status {
  text-align: center;
}

.privacy-note {
  margin-top: 20rpx;
  color: #817a83;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.mood-list {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.mood-option {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 24rpx 18rpx;
  color: #57515a;
  border: 1rpx solid rgba(46, 42, 49, 0.14);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.34);
  line-height: 1.25;
  text-align: left;
}

.mood-option.is-selected {
  color: #f9f6f1;
  border-color: #2e2a31;
  background: #2e2a31;
}

.mood-label {
  font-size: 28rpx;
  font-weight: 600;
}

.mood-detail {
  margin-top: 10rpx;
  font-size: 20rpx;
  opacity: 0.72;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.tag {
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(46, 42, 49, 0.14);
  border-radius: 999rpx;
  color: #5f5862;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.4);
}

.composition-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(46, 42, 49, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.36);
}

.composition-row {
  display: grid;
  grid-template-columns: 64rpx 1fr 72rpx;
  gap: 18rpx;
  align-items: center;
  color: #6d6670;
  font-size: 22rpx;
}

.composition-track {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(46, 42, 49, 0.1);
}

.composition-fill {
  height: 100%;
  border-radius: inherit;
  background: #777079;
}

.diagnostic-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(46, 42, 49, 0.1);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.32);
}

.diagnostic-title {
  margin-bottom: 4rpx;
  color: #514b54;
  font-size: 23rpx;
  font-weight: 600;
}

.diagnostic-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #777079;
  font-size: 21rpx;
}

.privacy-backdrop {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(26, 23, 29, 0.58);
}

.privacy-dialog {
  display: flex;
  width: 100%;
  max-width: 650rpx;
  flex-direction: column;
  box-sizing: border-box;
  padding: 40rpx 34rpx 32rpx;
  border-radius: 36rpx;
  background: #f4efe8;
  box-shadow: 0 28rpx 100rpx rgba(20, 18, 22, 0.28);
}

.privacy-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  line-height: 1.25;
}

.privacy-copy {
  margin-top: 24rpx;
  color: #655f68;
  font-size: 25rpx;
  line-height: 1.75;
}

.privacy-contract {
  margin-top: 18rpx;
  color: #776f79;
  font-size: 22rpx;
  text-align: center;
}

.privacy-action {
  margin-top: 24rpx;
}

.privacy-action + .privacy-action {
  margin-top: 14rpx;
}

@media (max-width: 340px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .mood-list {
    flex-direction: column;
  }

  .mood-option {
    width: 100%;
  }
}
