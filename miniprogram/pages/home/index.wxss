.page-shell {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.art-placeholder {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  border: 1rpx solid rgba(37, 34, 40, 0.12);
  border-radius: 48rpx;
  background: #f5f0e9;
}

.orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.72;
}

.orb-a {
  top: 90rpx;
  left: 70rpx;
  width: 350rpx;
  height: 290rpx;
  background: #bea6a4;
}

.orb-b {
  right: 40rpx;
  bottom: 60rpx;
  width: 300rpx;
  height: 330rpx;
  background: #93aaa5;
}

.flow-line {
  position: absolute;
  top: 330rpx;
  left: 30rpx;
  width: 610rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(245, 231, 197, 0.78);
  transform: rotate(-8deg);
}

.content {
  display: flex;
  flex-direction: column;
  padding: 54rpx 8rpx 20rpx;
}

.eyebrow {
  color: #6d6670;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 18rpx;
  font-family: serif;
  font-size: 74rpx;
  line-height: 1;
}

.copy {
  margin-top: 26rpx;
  color: #6d6670;
  font-size: 28rpx;
}

.gate-card {
  display: flex;
  flex-direction: column;
  margin-top: 42rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(37, 34, 40, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.42);
}

.gate-title {
  font-size: 28rpx;
  font-weight: 600;
}

.gate-copy {
  margin-top: 14rpx;
  color: #746d77;
  font-size: 24rpx;
  line-height: 1.7;
}
