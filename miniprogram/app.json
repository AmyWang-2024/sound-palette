{
  "pages": ["pages/home/index"],
  "window": {
    "navigationBarTitleText": "我的声音相册",
    "navigationBarBackgroundColor": "#eee9e1",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#eee9e1",
    "backgroundTextStyle": "light"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.record": {
      "desc": "用于在用户主动点击后分析十秒环境声音并生成抽象画面；不识别语音、不上传音频，临时文件立即删除"
    },
    "scope.writePhotosAlbum": {
      "desc": "仅在用户主动点击保存作品时，将生成的图片写入系统相册"
    }
  }
}
