{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "files": ["app.d.ts"],
